#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# For development, ensure gems are installed (volume mount may overwrite installed gems)
if [ "$RAILS_ENV" = "development" ]; then
  # Check if bundle needs to be run (Gemfile.lock exists but gems missing)
  if [ -f "Gemfile.lock" ] && ! bundle check > /dev/null 2>&1; then
    echo "Installing gems for development environment..."
    # Unset BUNDLE_WITHOUT to install all gems including dev/test
    unset BUNDLE_WITHOUT
    bundle install
  fi
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
