# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Test coverage reports
/coverage/

# RSpec temporary files
/spec/examples.txt

# Docker volumes
/docker/volumes/

# Editor directories
.vscode/
.idea/

# OS-specific files
.DS_Store
Thumbs.db

# Ruby/Rails specific (safety patterns)
*.gem
*.rbc
/.config
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# Environment variables (CRITICAL - prevents credential leaks)
.env
.env.*
!.env.example
.envrc

# Rails credentials (encrypted - but being extra safe)
/config/credentials/*.key
/config/credentials.yml.enc.backup

# Database files (prevent accidental commits of data)
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-shm
/db/*.sqlite3-wal

# Bundler
vendor/bundle/
.bundle/
Gemfile.lock.backup

# Rails cache and temp
/public/system
/public/uploads
/public/assets
/.sass-cache
/tmp/cache/

# RSpec
/coverage/
/spec/tmp/
capybara-*.html

# Sidekiq/Solid Queue
/solid_queue/
/dumps/

# Security - prevent committing sensitive files
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
id_rsa*
*.pub
config/initializers/secret_token.rb

# Backup files
*.bak
*.backup
*.swp
*.swo
*~

# macOS
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Desktop.ini
ehthumbs.db
ehthumbs_vista.db
[Tt]humbs.db
*.stackdump

# Linux
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Logs (comprehensive)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Package managers
node_modules/
bower_components/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*


# Ignore Kamal secrets (sensitive - contains passwords/API keys)
# Note: .kamal/hooks/*.sample files are safe to commit
/.kamal/secrets
/.kamal/secrets.*

# Ignore application config
/config/credentials/*.key
/config/credentials/*.key.enc