# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Rails Configuration
RAILS_ENV=development
# you can use this key for development purpose RAILS_MASTER_KEY = eb4e62f7e46d81308e6ae7f9c2cd23b0 
RAILS_MASTER_KEY=your_master_key_here
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=your_secret_key_base_here_minimum_32_characters_long


# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AWS Configuration for SNS Notifications
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
NOTIFICATION_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:hr-notifications

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_HOURS=24
DEVISE_JWT_SECRET_KEY=development_jwt_secret_key_minimum_64_characters_long_for_local_dev_only_do_not_use_in_production

# Background Jobs
JOB_CONCURRENCY=1

# Application Settings
API_VERSION=v1
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here
NOTIFICATION_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:notifications